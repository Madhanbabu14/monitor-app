{
  "Gateway": {
    "Port": 8080
  },
  "ReverseProxy": {
    "Routes": {
      "health": {
        "Order": 1,
        "ClusterId": "legacy",
        "Match": { "Path": "/health" }
      },
      "api-auth": {
        "Order": 2,
        "ClusterId": "legacy",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "api-s3": {
        "Order": 3,
        "ClusterId": "legacy",
        "Match": { "Path": "/api/s3/{**catch-all}" }
      },
      "api-monitor": {
        "Order": 4,
        "ClusterId": "legacy",
        "Match": { "Path": "/api/monitor/{**catch-all}" }
      },
      "api-catch-all": {
        "Order": 100,
        "ClusterId": "legacy",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "legacy": {
        "Destinations": {
          "destination1": { "Address": "http://legacy-backend:4001/" }
        }
      },
      "dotnet": {
        "Destinations": {
          "destination1": { "Address": "http://monitor-api:4000/" }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "AllowedHosts": "*"
}
