<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Monitor.Database</RootNamespace>
    <AssemblyName>Monitor.Database</AssemblyName>
    <!--
      This project has its own deploy cadence (run once, before Monitor.Api
      starts, as a migration step) and is intentionally NOT referenced by
      Monitor.Api - Monitor.Api never applies schema changes at runtime.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dbup-postgresql" Version="5.0.40" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="6.0.0" />
    <!--
      Dev-only seed (Seed/DevUserSeedScript.cs) hashes the randomly generated,
      never-persisted-in-plaintext seed passwords the same way Monitor.Identity
      will verify them later (bcrypt, $2a$ work factor 10) - see
      Script0001_UsedTables.sql's users.password_hash VARCHAR(255).
    -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scripts run in filename/ordinal order: used tables (0001) before the rest (0002). -->
    <EmbeddedResource Include="Scripts\*.sql" />
    <None Remove="Scripts\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Development.json')" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reused (not re-implemented) so the migration runner connects with the
      exact same VerifyFull-by-default TLS policy as Monitor.Api - only the
      DatabaseOptions.Primary section and NpgsqlDataSourceFactory are needed,
      this does NOT pull in the app's HTTP/hosting pipeline.
    -->
    <ProjectReference Include="..\Monitor.Core\Monitor.Core.csproj" />
    <ProjectReference Include="..\Monitor.Data\Monitor.Data.csproj" />
  </ItemGroup>

</Project>
